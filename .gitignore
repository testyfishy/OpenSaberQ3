.import
src_data
.DS_STORE

# ignore exported APKs
*.apk
*.idsig
/build/
.godot/
android/build/*
/addons/godotopenxrvendors

# Spec Kit state is machine-local agent tooling, not project source
.specify/

# performance captures: raw logcat is local-only, summary*.json is the evidence that ships
perf/captures/*.logcat.txt
perf/captures/*.txt
perf/captures/*.wav
perf/captures/*.csv
perf/captures/*.meta.txt
perf_run_*

# release signing key (kept locally; never commit)
bin/release.keystore

