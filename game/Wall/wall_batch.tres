[gd_resource type="ShaderMaterial" format=3]

[sub_resource type="Shader" id="1"]
code = "shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_back;

// Batched wall panel (0.7.6). Same look as wall_shared.tres, but size/rim come from
// INSTANCE_CUSTOM and colour/fade from the MultiMesh per-instance colour.

varying vec3 local_pos;
varying vec3 local_n;
varying vec3 v_size;
varying float v_rim;
varying vec4 v_color;

void vertex() {
	v_size = INSTANCE_CUSTOM.xyz;
	v_rim = INSTANCE_CUSTOM.w;
	v_color = COLOR;
	VERTEX *= v_size;
	local_pos = VERTEX;
	local_n = NORMAL;
}

void fragment() {
	vec3 half_size = v_size * 0.5;
	vec3 p = local_pos;

	float d;
	if (abs(local_n.x) > 0.5) {
		d = min(half_size.y - abs(p.y), half_size.z - abs(p.z));
	} else if (abs(local_n.y) > 0.5) {
		d = min(half_size.x - abs(p.x), half_size.z - abs(p.z));
	} else {
		d = min(half_size.x - abs(p.x), half_size.y - abs(p.y));
	}

	float rim_mask = 1.0 - smoothstep(0.015 - fwidth(d), 0.015 + fwidth(d), d);

	float up = clamp(p.y / max(half_size.y, 0.001) * 0.5 + 0.5, 0.0, 1.0);
	float body = mix(0.80, 1.00, up);
	float bottom = smoothstep(-half_size.y, -half_size.y + 0.03, p.y);
	float rim_gain = rim_mask * mix(0.55, 0.35, bottom) * v_rim;

	vec3 col = v_color.rgb * (body + rim_gain);
	ALBEDO = col * v_color.a;
	ALPHA = clamp(v_color.a * (0.55 + 0.45 * rim_mask), 0.0, 1.0);
}
"

[resource]
render_priority = 0
shader = SubResource("1")
