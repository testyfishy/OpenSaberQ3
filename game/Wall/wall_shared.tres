[gd_resource type="ShaderMaterial" format=3]

[sub_resource type="Shader" id="1"]
code = "shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_back;

// Walls (v0.4): a translucent additive panel with a bright frame, not a noise cutout. Additive
// needs no sorting and keeps the notes readable through the wall; cull_back keeps the overdraw of
// a two-faced box down to one layer. Per-wall values are instance uniforms, so every wall shares
// this material and the renderer does not switch materials per wall.

instance uniform vec4 wall_color : source_color = vec4(1.0, 0.08, 0.08, 1.0);
instance uniform vec3 size = vec3(1.0);
instance uniform float fade = 1.0;

const float RIM_M = 0.015;

varying vec3 local_pos;
varying vec3 local_n;

void vertex() {
	local_pos = VERTEX * size;
	// NORMAL is view-space in the fragment stage, so the face chosen for the rim would change
	// with head orientation. This is the model-space normal, valid for an unrotated box.
	local_n = NORMAL;
}

void fragment() {
	vec3 half_size = size * 0.5;
	vec3 p = local_pos;

	// Distance to the nearest edge of the face we are shading, in metres. Using the two in-face
	// axes means a thin wall and a wide wall get the same rim thickness.
	float d;
	if (abs(local_n.x) > 0.5) {
		d = min(half_size.y - abs(p.y), half_size.z - abs(p.z));
	} else if (abs(local_n.y) > 0.5) {
		d = min(half_size.x - abs(p.x), half_size.z - abs(p.z));
	} else {
		d = min(half_size.x - abs(p.x), half_size.y - abs(p.y));
	}

	float rim = 1.0 - smoothstep(RIM_M - fwidth(d), RIM_M + fwidth(d), d);

	// Vertical gradient: brighter at the top, so the panel reads as a lit surface.
	float up = clamp(p.y / max(half_size.y, 0.001) * 0.5 + 0.5, 0.0, 1.0);
	float body = mix(0.10, 0.20, up);

	// The bottom edge is a little brighter, which gives a contact cue where the wall meets the
	// floor without a separate decal.
	float bottom = smoothstep(-half_size.y, -half_size.y + RIM_M * 2.0, p.y);
	float rim_gain = rim * mix(1.35, 1.05, bottom);

	vec3 col = wall_color.rgb * (body + rim_gain);
	// Near-camera fade: a wall against the player's face must not flood the screen.
	// Fragment-stage VERTEX is view space: the true per-pixel distance to the camera.
	float near = smoothstep(0.25, 1.0, abs(VERTEX.z));
	ALBEDO = col * near * fade;
}
"

[resource]
render_priority = 0
shader = SubResource("1")
shader_parameter/wall_color = Color(1, 0.08, 0.08, 1)
shader_parameter/size = Vector3(1, 1, 1)
