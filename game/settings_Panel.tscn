text = "Render Scale: "

[node name="render_scale" type="HSlider" parent="ScrollContainer/VBox/RenderScaleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 1
tooltip_text = "Per-eye resolution multiplier. 1.25 is tuned for Quest 3; lower it for weaker headsets, raise it for sharper image if frames still hold."
min_value = 0.7
max_value = 1.5
step = 0.0001
value = 1.2546

