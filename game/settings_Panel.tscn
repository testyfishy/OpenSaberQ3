layout_mode = 2
theme = SubResource("3")
text = "Refresh Rate: "

[node name="refresh_rate" type="OptionButton" parent="ScrollContainer/VBox/RefreshRateRow"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(150, 0)
tooltip_text = "Display refresh rate. Physics runs at the same rate so hit detection samples every displayed frame."
theme = SubResource("5")
theme_override_fonts/font = SubResource("4")
flat = true

