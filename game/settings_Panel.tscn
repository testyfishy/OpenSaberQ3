[node name="hit_sound" type="OptionButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Classic is the shipped impact. Thump re-derives it with a low-shelf boost and a 2.5 kHz cut, for a heavier hit. Headphones recommended: the extra low end is mostly below what the headset speakers reproduce."
theme = SubResource("3")

[node name="recenter" type="Button" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Recenter"

