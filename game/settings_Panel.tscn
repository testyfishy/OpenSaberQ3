layout_mode = 2

[node name="msaa_label" type="Label" parent="ScrollContainer/VBox/MSAARow"]
layout_mode = 2
theme = SubResource("3")
text = "Anti-Aliasing: "

[node name="msaa" type="OptionButton" parent="ScrollContainer/VBox/MSAARow"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(150, 0)
tooltip_text = "MSAA. Changing it rebuilds render pipelines, so the image may hitch for a moment. Takes effect immediately."
theme = SubResource("5")
theme_override_fonts/font = SubResource("4")
flat = true

[node name="FoveationRow" type="HBoxContainer" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="foveation_label" type="Label" parent="ScrollContainer/VBox/FoveationRow"]
layout_mode = 2
theme = SubResource("3")
text = "Foveated Rendering: "

[node name="foveation" type="OptionButton" parent="ScrollContainer/VBox/FoveationRow"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(150, 0)
tooltip_text = "Renders the edges of the view at lower resolution. Trades peripheral sharpness for performance."
theme = SubResource("5")
theme_override_fonts/font = SubResource("4")
flat = true

[node name="PerfNote" type="Label" parent="ScrollContainer/VBox"]
layout_mode = 2
theme = SubResource("3")
theme_override_font_sizes/font_size = 10
text = "Performance settings above apply immediately; anti-aliasing may hitch for a moment."
autowrap_mode = 3

[node name="d_background" type="CheckButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Low Performance impact*"
theme = SubResource("3")
text = "*Dynamic Background: "

[node name="cut_blocks" type="CheckButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "High Performance impact*"
theme = SubResource("3")
text = "*Cut Blocks: "

[node name="floor_light" type="CheckButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Light pool under each blade, drawn analytically by the floor shader from the saber positions. No extra render pass, no second viewport."
theme = SubResource("3")
text = "Saber Floor Light: "

[node name="saber_halo" type="CheckButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Additive emissive halo around each blade. One extra draw call per saber, no depth write."
theme = SubResource("3")
text = "Saber Halo: "

[node name="mirror_reflections" type="CheckButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "High Performance impact*\nMirrors sabers and notes under a slightly translucent floor. Doubles the draw calls for those objects. Visual only: no collision, no Area3D, so the hit test cannot see it."
theme = SubResource("3")
text = "*Mirrored Reflections: "

[node name="saber_tail" type="CheckButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "High Performance impact*"
theme = SubResource("3")
text = "*Saber Tail: "

[node name="hit_flash" type="CheckButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "A short burst of light on the floor where your blade cut the note (about 80 ms, fading out). Drawn inside the floor shader that is already running: one uniform write per cut, no extra draw call."
theme = SubResource("3")
text = "Cut Flash: "

[node name="floor_grid" type="CheckButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Low Performance impact\nA faint grid on the floor so the room reads as a floor. Anti-aliased in the fragment shader: about one fwidth per floor pixel, inside the pass the floor already runs."
theme = SubResource("3")
text = "Floor Grid: "

[node name="event_tint" type="CheckButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Low Performance impact\nLight events in the map tint the light your blades throw on the floor. Applied once where the light colour is published, so the floor and the blade glow share it; blade light never goes fully dark."
theme = SubResource("3")
text = "Map Light Tint: "

[node name="debris_shards" type="CheckButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Very low performance impact\nEvery cut throws ten little note-coloured shards. They fly along the cut plane, tumble, fall and shrink away. Drawn as one batch of 128 boxes - one draw call - and moved entirely on the GPU, so a cut allocates nothing."
theme = SubResource("3")
text = "Break Debris: "

[node name="debris_cap" type="CheckButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Saves a little performance\nHalves each burst from ten shards to six, so the same 128-shard pool covers more cuts. Unlike the old slice particles, no burst is ever skipped."
theme = SubResource("3")
text = "Limit Debris: "

[node name="environment_mode" type="OptionButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(150, 0)
tooltip_text = "Very low performance impact\nAuto uses the colours and mood of the environment the map was made for (the room itself is ours, not Beat Saber's art). Classic is the old look: your colours, the fixed red walls."
theme = SubResource("3")

[node name="glow_mode" type="OptionButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(150, 0)
tooltip_text = "Measured on Quest 3 at about 1% of the GPU budget. Subtle keeps one blur level; Full is Godot's authored chain. Turn it off for the flattest possible image."
theme = SubResource("3")

[node name="sky_style" type="OptionButton" parent="ScrollContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(150, 0)
tooltip_text = "What is behind the play space. Black void is the default and the cheapest to draw; ambient light is set explicitly so the scene does not go dull without a sky. Gradient is a texture-free horizon. Panorama is the original background art."
theme = SubResource("3")

